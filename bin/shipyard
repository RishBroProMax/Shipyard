#!/usr/bin/env bash
# ==============================================================================
# Shipyard PaaS — Global Management CLI
# Location: /usr/local/bin/shipyard
# ==============================================================================

set -euo pipefail

# ── Colors & Styles ───────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Installation Paths ────────────────────────────────────────────────────────
SHIPYARD_DATA_DIR="${SHIPYARD_DATA_DIR:-/var/lib/shipyard}"
INSTALL_SOURCE="${SHIPYARD_DATA_DIR}/source"
ENV_FILE="${INSTALL_SOURCE}/.env"
COMPOSE_FILE="${INSTALL_SOURCE}/docker-compose.yml"
SECRETS_FILE="${SHIPYARD_DATA_DIR}/data/secrets/shipyard.secret.json"

# Check sudo / root
SUDO=""
if [ "$EUID" -ne 0 ]; then
    if command -v sudo &>/dev/null; then
        SUDO="sudo"
    fi
fi

# ── Helper: Banner ────────────────────────────────────────────────────────────
show_banner() {
    echo -e "${CYAN}${BOLD}"
    cat << "BANNER"
  ____  _     _                         _
 / ___|| |__ (_) _ __  _   _  __ _ _ __| |
 \___ \| '_ \| || '_ \| | | |/ _` | '__| |
  ___) | | | | || |_) | |_| | (_| | |  |_|
 |____/|_| |_|_|| .__/ \__, |\__,_|_|  (_)
                |_|    |___/
  Self-Hosted PaaS Appliance Management CLI
BANNER
    echo -e "${NC}"
}

# ── Command: help ─────────────────────────────────────────────────────────────
cmd_help() {
    show_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  shipyard <command> [arguments]\n"
    echo -e "${BOLD}CORE COMMANDS:${NC}"
    echo -e "  ${CYAN}update${NC}           Fetch latest updates from GitHub and reinstall with ${BOLD}ZERO data loss${NC}"
    echo -e "  ${CYAN}status${NC}           Show live cluster status, hardware telemetry & container health"
    echo -e "  ${CYAN}logs [service]${NC}   Stream live logs (shipyard-app, shipyard-proxy, shipyard-db, shipyard-redis)"
    echo -e "  ${CYAN}restart${NC}          Restart all Shipyard services safely"
    echo -e "  ${CYAN}stop${NC}             Stop all running Shipyard services"
    echo -e "  ${CYAN}start${NC}            Start Shipyard services"
    echo -e "  ${CYAN}reset-password${NC}   Reset administrator login credentials"
    echo -e "  ${CYAN}version${NC}          Display installed commit and version information"
    echo -e "  ${RED}uninstall${NC}        Completely uninstall Shipyard PaaS (preserves data by default)\n"
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo -e "  shipyard update"
    echo -e "  shipyard update --force"
    echo -e "  shipyard logs shipyard-app"
    echo -e "  shipyard reset-password admin@company.com \"MyNewPassword123\""
    echo -e "  shipyard status"
    echo ""
}

# ── Command: update ───────────────────────────────────────────────────────────
cmd_update() {
    show_banner
    echo -e "${BLUE}${BOLD}═════════════════════════════════════════════════════════════════${NC}"
    echo -e "  ${CYAN}${BOLD}SHIPYARD UPDATE MANAGER — ZERO DATA LOSS ASSURED${NC}"
    echo -e "${BLUE}${BOLD}═════════════════════════════════════════════════════════════════${NC}\n"

    if [ ! -d "${INSTALL_SOURCE}/.git" ]; then
        echo -e "${RED}Error: Shipyard installation source not found at ${INSTALL_SOURCE}.${NC}"
        echo -e "Please ensure Shipyard was installed via the official install.sh script."
        exit 1
    fi

    cd "${INSTALL_SOURCE}"

    echo -e "${CYAN}▶ Checking for updates on origin/main...${NC}"
    $SUDO git fetch origin main --quiet

    LOCAL_HASH=$(git rev-parse HEAD)
    REMOTE_HASH=$(git rev-parse origin/main)
    FORCE_UPDATE=false

    if [[ "${1:-}" == "--force" || "${1:-}" == "-f" ]]; then
        FORCE_UPDATE=true
    fi

    if [ "$LOCAL_HASH" = "$REMOTE_HASH" ] && [ "$FORCE_UPDATE" = false ]; then
        echo -e "${GREEN}✓ Shipyard is already at the latest version!${NC}"
        echo -e "  Current Commit: ${YELLOW}${LOCAL_HASH:0:8}${NC} ($(git log -1 --format=%cd --date=relative))"
        echo -e "\n  Tip: Run ${CYAN}shipyard update --force${NC} to force rebuild container layers anyway.\n"
        exit 0
    fi

    BEHIND_COUNT=$(git rev-list HEAD..origin/main --count)
    echo -e "  Found ${YELLOW}${BEHIND_COUNT}${NC} new commit(s) from GitHub:"
    git log --oneline HEAD..origin/main | head -n 5 | sed 's/^/    • /'
    echo ""

    echo -e "${CYAN}▶ Backing up environment configuration...${NC}"
    if [ -f "${ENV_FILE}" ]; then
        $SUDO cp "${ENV_FILE}" "${ENV_FILE}.bak.$(date +%s)"
        echo -e "${GREEN}  ✓ Configuration preserved.${NC}"
    fi

    echo -e "${CYAN}▶ Pulling latest code changes...${NC}"
    $SUDO git pull --ff-only origin main || (git fetch --all && git reset --hard origin/main)
    echo -e "${GREEN}  ✓ Latest release pulled successfully.${NC}"

    echo -e "${CYAN}▶ Updating global CLI binary...${NC}"
    if [ -f "${INSTALL_SOURCE}/bin/shipyard" ]; then
        $SUDO cp "${INSTALL_SOURCE}/bin/shipyard" /usr/local/bin/shipyard
        $SUDO chmod +x /usr/local/bin/shipyard
    fi

    echo -e "${CYAN}▶ Rebuilding and restarting container stack...${NC}"
    echo -e "  ${DIM}(This preserves your databases, apps, and SSL certificates)${NC}"
    
    $SUDO docker compose --env-file "${ENV_FILE}" build shipyard-app
    $SUDO docker compose --env-file "${ENV_FILE}" up -d --remove-orphans

    echo -e "\n${CYAN}▶ Verifying appliance health...${NC}"
    PORT=$(grep '^SHIPYARD_PORT=' "${ENV_FILE}" 2>/dev/null | cut -d'=' -f2 || echo "3000")
    PORT=${PORT:-3000}
    sleep 3
    MAX_WAIT=60
    WAIT=0
    HEALTHY=false
    while [ $WAIT -lt $MAX_WAIT ]; do
        STATUS=$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:${PORT}/api/health" 2>/dev/null || echo 000)
        if [ "$STATUS" = "200" ]; then
            HEALTHY=true
            break
        fi
        sleep 2
        WAIT=$((WAIT + 2))
    done

    if [ "$HEALTHY" = true ]; then
        NEW_HASH=$(git rev-parse HEAD)
        echo -e "\n${GREEN}${BOLD}═════════════════════════════════════════════════════════════════${NC}"
        echo -e "${GREEN}${BOLD}  ✓ SHIPYARD HAS BEEN SUCCESSFULLY UPDATED!${NC}"
        echo -e "${GREEN}${BOLD}═════════════════════════════════════════════════════════════════${NC}"
        echo -e "  Updated to Commit: ${YELLOW}${NEW_HASH:0:8}${NC}"
        echo -e "  All volumes, databases, apps, and SSL certificates are intact."
        echo -e "  Appliance Health:  ${GREEN}HTTP 200 OK${NC}\n"
    else
        echo -e "\n${YELLOW}⚠ Update completed, but health probe is still starting.${NC}"
        echo -e "  Check status with: ${CYAN}shipyard status${NC} or ${CYAN}shipyard logs${NC}\n"
    fi
}

# ── Command: status ───────────────────────────────────────────────────────────
cmd_status() {
    show_banner
    echo -e "${BOLD}APPLIANCE SERVICES:${NC}"
    cd "${INSTALL_SOURCE}" && $SUDO docker compose --env-file "${ENV_FILE}" ps
    echo ""

    echo -e "${BOLD}SYSTEM HEALTH:${NC}"
    PORT=$(grep '^SHIPYARD_PORT=' "${ENV_FILE}" 2>/dev/null | cut -d'=' -f2 || echo "3000")
    PORT=${PORT:-3000}
    HEALTH_JSON=$(curl -s --max-time 3 "http://localhost:${PORT}/api/health" 2>/dev/null || echo "")
    if [ -n "$HEALTH_JSON" ]; then
        echo -e "  Health Check:    ${GREEN}ONLINE (HTTP 200)${NC}"
        UPTIME=$(echo "$HEALTH_JSON" | grep -o '"uptimeSeconds":[0-9]*' | cut -d':' -f2 || echo "0")
        echo -e "  Uptime:          ${CYAN}${UPTIME} seconds${NC}"
    else
        echo -e "  Health Check:    ${RED}OFFLINE or starting up${NC}"
    fi

    IP=$(curl -s --max-time 3 https://api.ipify.org 2>/dev/null || echo "YOUR_VPS_IP")
    echo -e "  Dashboard URL:   ${CYAN}http://${IP}:${PORT}${NC}\n"
}

# ── Command: logs ─────────────────────────────────────────────────────────────
cmd_logs() {
    SERVICE="${1:-shipyard-app}"
    echo -e "${CYAN}Tailing logs for service '${SERVICE}' (Ctrl+C to stop)...${NC}\n"
    cd "${INSTALL_SOURCE}" && $SUDO docker compose --env-file "${ENV_FILE}" logs -f "$SERVICE"
}

# ── Command: restart ──────────────────────────────────────────────────────────
cmd_restart() {
    echo -e "${CYAN}Restarting Shipyard PaaS services...${NC}"
    cd "${INSTALL_SOURCE}" && $SUDO docker compose --env-file "${ENV_FILE}" restart
    echo -e "${GREEN}✓ All services restarted.${NC}"
}

# ── Command: stop ─────────────────────────────────────────────────────────────
cmd_stop() {
    echo -e "${YELLOW}Stopping Shipyard PaaS services...${NC}"
    cd "${INSTALL_SOURCE}" && $SUDO docker compose --env-file "${ENV_FILE}" stop
    echo -e "${GREEN}✓ Services stopped.${NC}"
}

# ── Command: start ────────────────────────────────────────────────────────────
cmd_start() {
    echo -e "${CYAN}Starting Shipyard PaaS services...${NC}"
    cd "${INSTALL_SOURCE}" && $SUDO docker compose --env-file "${ENV_FILE}" up -d
    echo -e "${GREEN}✓ Services started.${NC}"
}

# ── Command: reset-password ───────────────────────────────────────────────────
cmd_reset_password() {
    EMAIL="${1:-}"
    PASS="${2:-}"

    if [ -z "$EMAIL" ]; then
        printf "Enter user email: "
        read -r EMAIL
    fi

    if [ -z "$PASS" ]; then
        printf "Enter new password: "
        stty -echo 2>/dev/null || true
        read -r PASS
        stty echo 2>/dev/null || true
        echo ""
    fi

    cd "${INSTALL_SOURCE}"
    node scripts/init-appliance.js --reset-password "$EMAIL" "$PASS"
}

# ── Command: version ──────────────────────────────────────────────────────────
cmd_version() {
    if [ -d "${INSTALL_SOURCE}/.git" ]; then
        cd "${INSTALL_SOURCE}"
        HASH=$(git rev-parse --short HEAD)
        DATE=$(git log -1 --format=%cd --date=short)
        echo -e "Shipyard PaaS Appliance ${BOLD}v1.0.0${NC} (${CYAN}${HASH}${NC} · ${DATE})"
    else
        echo "Shipyard PaaS Appliance v1.0.0"
    fi
}

# ── Command: uninstall ────────────────────────────────────────────────────────
cmd_uninstall() {
    show_banner
    echo -e "${RED}${BOLD}═════════════════════════════════════════════════════════════════${NC}"
    echo -e "  ${RED}${BOLD}WARNING: SHIPYARD PAAS UNINSTALLATION${NC}"
    echo -e "${RED}${BOLD}═════════════════════════════════════════════════════════════════${NC}\n"

    echo -e "${YELLOW}This will stop and remove all Shipyard control plane containers.${NC}"
    printf "Are you sure you want to proceed? [y/N]: "
    read -r CONFIRM
    if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" && "$CONFIRM" != "yes" ]]; then
        echo -e "${CYAN}Uninstallation cancelled.${NC}"
        exit 0
    fi

    echo ""
    printf "Do you want to DELETE persistent data (/var/lib/shipyard/data)? [y/N] (Default: No): "
    read -r DELETE_DATA

    echo -e "\n${CYAN}▶ Stopping and removing Docker containers...${NC}"
    if [ -d "${INSTALL_SOURCE}" ]; then
        cd "${INSTALL_SOURCE}"
        $SUDO docker compose --env-file "${ENV_FILE}" down --remove-orphans 2>/dev/null || true
    fi

    if [[ "$DELETE_DATA" == "y" || "$DELETE_DATA" == "Y" ]]; then
        echo -e "${RED}▶ Deleting persistent data directory ${SHIPYARD_DATA_DIR}...${NC}"
        $SUDO rm -rf "${SHIPYARD_DATA_DIR}"
        echo -e "${GREEN}  ✓ Data directory removed.${NC}"
    else
        echo -e "${GREEN}▶ Keeping persistent data at ${SHIPYARD_DATA_DIR}/data safe.${NC}"
    fi

    echo -e "${CYAN}▶ Removing global CLI command...${NC}"
    $SUDO rm -f /usr/local/bin/shipyard

    echo -e "\n${GREEN}${BOLD}✓ Shipyard PaaS has been completely uninstalled.${NC}\n"
}

# ── CLI Entrypoint ────────────────────────────────────────────────────────────
ACTION="${1:-help}"
shift || true

case "$ACTION" in
    update)          cmd_update "$@" ;;
    status)          cmd_status "$@" ;;
    logs)            cmd_logs "$@" ;;
    restart)         cmd_restart "$@" ;;
    stop)            cmd_stop "$@" ;;
    start)           cmd_start "$@" ;;
    reset-password)  cmd_reset_password "$@" ;;
    version|-v|--version) cmd_version ;;
    uninstall)       cmd_uninstall "$@" ;;
    help|-h|--help)  cmd_help ;;
    *)
        echo -e "${RED}Unknown command: ${ACTION}${NC}\n"
        cmd_help
        exit 1
        ;;
esac
