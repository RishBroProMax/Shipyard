# ============================================================
# Shipyard PaaS - Production Environment Variables
# ============================================================
# Copy this file to .env and set real values before deploying.

# ----------------------------------------------------------
# REQUIRED ON VPS (appliance mode)
# ----------------------------------------------------------

# Shipyard operating mode. Set to "appliance" on VPS.
# Vercel deployments automatically detect VERCEL=1 (no config needed).
SHIPYARD_MODE=appliance

# Path where Shipyard stores data, secrets, and deployment files.
SHIPYARD_DATA_DIR=/var/lib/shipyard/data

# Administrator credentials (used on first boot to seed the database).
SHIPYARD_ADMIN_EMAIL=admin@example.com
SHIPYARD_ADMIN_PASSWORD=your-secure-password-here

# PostgreSQL connection string (auto-configured by install.sh).
DATABASE_URL=postgresql://shipyard:GENERATED_BY_INSTALLER@localhost:5432/shipyard

# Redis connection (auto-configured by install.sh).
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# AUTO-GENERATED ON FIRST BOOT (do NOT set manually)
# Written to: $SHIPYARD_DATA_DIR/secrets/shipyard.secret.json
# ----------------------------------------------------------

# JWT signing secret (generated automatically)
# SHIPYARD_JWT_SECRET=

# AES-256-GCM encryption key (generated automatically)
# SHIPYARD_ENCRYPTION_KEY=

# Agent cluster token (generated automatically)
# SHIPYARD_AGENT_TOKEN=

# ----------------------------------------------------------
# OPTIONAL CONFIGURATION
# ----------------------------------------------------------

# Port to run the Shipyard dashboard on (default: 3000)
# SHIPYARD_PORT=3000

# Vercel deployment - set to "1" if deploying to Vercel manually
# (Vercel sets this automatically)
# VERCEL=1

# Enable debug logging
# SHIPYARD_DEBUG=true
